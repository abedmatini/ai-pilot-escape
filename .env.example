# Google AI Studio key for the cloud path (LiteLLM id: gemini/gemini-3.6-flash).
# Create a key at https://aistudio.google.com/apikey
# Then:  cp .env.example .env   and paste the key after the equals sign.
# In Cursor: open `.env` at the repo root and paste there. Never commit `.env`.
GEMINI_API_KEY=

# Optional overrides (defaults match the talk)
OLLAMA_HOST=http://localhost:11434
LOCAL_MODEL=ollama/qwen2.5:0.5b
CLOUD_MODEL=gemini/gemini-3.6-flash

# LiteLLM proxy (scripts/start-litellm.sh)
LITELLM_PORT=4000
LITELLM_HOST=127.0.0.1
LITELLM_LOG=INFO
# LITELLM_MASTER_KEY=

# Point the CLI at a running proxy instead of calling providers from Python
# LITELLM_BASE_URL=http://127.0.0.1:4000
